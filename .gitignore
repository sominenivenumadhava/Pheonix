# ==============================================================================
# PHOENIX PROJECT - .gitignore
# Disaster Recovery as Code for a Small Business with Self-Healing DevOps Automation
# ==============================================================================

# --- Operating System & Editor Files ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# --- Security, Credentials & Secrets (STRICT: Rule 3) ---
*.pem
*.key
*.pub
*.id_rsa
id_rsa*
*.cer
*.crt
*.pfx
*.p12
.env
.env.*
!.env.example
credentials
*credentials*
*secret*
!*secret*.example

# --- Python / FastAPI / Uvicorn ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
!puppet/**/lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Node.js / React / Vite / TypeScript ---
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Databases & Backup Files (STRICT: Rule 3) ---
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
*.bak
*.backup
*.dump
*.sql
*.tar.gz
*.tgz
*.zip
backups/
/var/backups/
/var/lib/phoenix/

# --- Terraform ---
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# --- Ansible ---
.vault_pass
.vault_pass*
*.vault_pass
*vault_pass*
*.retry
ansible.log

# --- Puppet ---
.librarian/
.tmp/
pkg/
spec/fixtures/
reports/

# --- Nagios ---
nagios.log
spool/
var/
retention.dat
status.dat

# --- Temporary & Scratch Files ---
tmp/
temp/
scratch/

# Local Terraform Binary
terraform_bin/
