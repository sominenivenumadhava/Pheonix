# ==============================================================================
# Phoenix Nginx Virtual Host Configuration
# Automatically generated by Puppet Master
# Host FQDN: <%= @facts['networking']['fqdn'] rescue @fqdn %>
# Primary IP: <%= @facts['networking']['ip'] rescue @ipaddress %>
# Processor Count: <%= @facts['processors']['count'] rescue 1 %>
# ==============================================================================

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /var/www/phoenix;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml;

    # Serve static compiled React application
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy to FastAPI Uvicorn backend daemon and operational probes
    location ~ ^/(api|auth|health|ready|docs|openapi.json) {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
