# ==============================================================================
# Phoenix NRPE Configuration File (nrpe.cfg)
# Generated by Puppet Master for <%= @facts['networking']['fqdn'] rescue @fqdn %>
# ==============================================================================
log_facility=daemon
pid_file=/var/run/nagios/nrpe.pid
server_port=5666
nrpe_user=nagios
nrpe_group=nagios
allowed_hosts=127.0.0.1,::1,192.168.56.40,10.0.0.0/16
dont_blame_nrpe=0
allow_bash_command_substitution=0

# Core System Checks
command[check_users]=/usr/lib/nagios/plugins/check_users -w 5 -c 10
command[check_load]=/usr/lib/nagios/plugins/check_load -r -w 5.0,4.0,3.0 -c 10.0,6.0,4.0
command[check_disk]=/usr/lib/nagios/plugins/check_disk -w 20% -c 10% -p /
command[check_zombie_procs]=/usr/lib/nagios/plugins/check_procs -w 5 -c 10 -s Z
command[check_total_procs]=/usr/lib/nagios/plugins/check_procs -w 150 -c 200

# Custom Phoenix Probes
command[check_portal_health]=/usr/bin/python3 /opt/phoenix/nagios/plugins/check_portal_health.py --url http://127.0.0.1/health
command[check_web_errors]=/bin/bash /opt/phoenix/nagios/plugins/check_web_errors.sh /var/log/nginx/access.log
